# Database
DATABASE_URL=postgresql://delivery_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/delivery_cruzeiro?schema=public

# Server
PORT=4000
NODE_ENV=production

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.deliverycruzeiro.com

# AbacatePay
ABACATEPAY_API_KEY=
ABACATEPAY_API_URL=https://api.abacatepay.com.br

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=delivery-cruzeiro

# Email (SMTP)
SMTP_HOST=smtp.production-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email@example.com
SMTP_PASS=
SMTP_FROM=noreply@deliverycruzeiro.com

# WhatsApp
WHATSAPP_API_URL=https://api.whatsapp-service.com
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=5511999999999

# CORS
FRONTEND_URL=https://deliverycruzeiro.com

# Fiscal / SEFAZ
CERTIFICATE_PATH=
# Configure the certificate password only in the private deployment environment.
SEFAZ_ENVIRONMENT=1
SEFAZ_AUTHORIZATION_URL=
SEFAZ_NFE_AUTHORIZATION_URL=
SEFAZ_NFCE_AUTHORIZATION_URL=
SEFAZ_AUTHORIZATION_URL_HOMOLOG=
CSC_ID=
CSC_PRODUCTION=
CSC_HOMOLOGATION=
NFCE_QRCODE_URL_PRODUCTION=https://www.sefaz.pb.gov.br/nfce/qrcode
NFCE_QRCODE_URL_HOMOLOGATION=https://www.sefaz.pb.gov.br/nfce/qrcode-homolog

# Generate unique values using the Infra Docker setup. Never reuse sample keys.
APP_DB_PASSWORD=
DATA_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8080
ALLOW_INSECURE_LOCALHOST=true
