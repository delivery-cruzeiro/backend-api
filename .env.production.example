# Database
DATABASE_URL=postgresql://delivery_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/delivery_cruzeiro?schema=public

# Server
PORT=4000
NODE_ENV=production

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.deliverycruzeiro.com

# AbacatePay
ABACATEPAY_API_KEY=
ABACATEPAY_API_URL=https://api.abacatepay.com.br

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=delivery-cruzeiro

# Email (SMTP)
SMTP_HOST=smtp.production-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email@example.com
SMTP_PASS=
SMTP_FROM=noreply@deliverycruzeiro.com
EMAIL_COMPANY_NAME="Delivery Cruzeiro"

# WhatsApp
WHATSAPP_API_URL=https://api.whatsapp-service.com
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=5511999999999

# CORS
FRONTEND_URL=https://deliverycruzeiro.com

# Emissão fiscal PB / SVRS. Produção depende de ativação explícita.
CERTIFICATE_PATH=
FISCAL_CERTIFICATE_ISSUER_CNPJ=
FISCAL_CERTIFICATE_FINGERPRINT=
FISCAL_XSD_DIR=
FISCAL_PRODUCTION_ENABLED=false
NFCE_QRCODE_URL_PRODUCTION=
NFCE_ACCESS_KEY_URL_PRODUCTION=
NFCE_QRCODE_URL_HOMOLOGATION=
NFCE_ACCESS_KEY_URL_HOMOLOGATION=
# Configure CERTIFICATE_PASSWORD somente no ambiente privado.

# Generate unique values using the Infra Docker setup. Never reuse sample keys.
APP_DB_PASSWORD=
DATA_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8080
ALLOW_INSECURE_LOCALHOST=true
