// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MODELO USER (Usuários)
// ============================================

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified Boolean     @default(false)
  password      String?
  name          String
  cpf           String?
  gender        UserGender?
  phone         String?
  avatar        String?
  role          UserRole    @default(CLIENT)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  addresses        Address[]
  paymentMethods   PaymentMethod[]
  orders           Order[]
  notifications    Notification[]
  points           Point[]
  reviews          Review[]
  favorites        Favorite[]
  groupMemberships UserGroupMember[]
  ownedStores      Store[]           @relation("StoreOwner")
  stores           Store[]           @relation("UserStores")
  createdCarousels Carousel[]        @relation("CarouselCreator")
  updatedCarousels Carousel[]        @relation("CarouselUpdater")

  // Better Auth fields
  accounts Account[]
  sessions Session[]

  @@index([email])
  @@index([role])
  @@index([cpf(ops: raw("text_pattern_ops"))], map: "User_cpf_prefix_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_prefix_idx")
}

// ============================================
// MODELO ACCOUNT (Better Auth)
// ============================================

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// MODELO SESSION (Better Auth)
// ============================================

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model LoginAttempt {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum UserRole {
  CLIENT
  ADMIN
  MANAGER
  SUPER_ADMIN
}

enum UserGender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum SystemLayout {
  QUIET_OPS
  MOTION_CANVAS
  CRAVE_MARKET
}

// ============================================
// MODELO ADDRESS (Endereços)
// ============================================

model Address {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street           String
  number           String
  complement       String?
  neighborhood     String
  city             String
  state            String
  zipCode          String
  zipCodeValidated Boolean  @default(false) @map("zip_code_validated")
  latitude         Float?
  longitude        Float?
  locationConfirmed Boolean @default(false) @map("location_confirmed")
  geocodingKey String? @map("geocoding_key")
  geocodingAttemptedAt DateTime? @map("geocoding_attempted_at")
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]
  stores Store[] @relation("StoreAddress")

  @@index([userId])
}

// ============================================
// MODELO STORE (Lojas/Unidades)
// ============================================

model Store {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  nickname     String
  isActive     Boolean      @default(true) @map("is_active")
  layout       SystemLayout @default(MOTION_CANVAS) @map("system_layout")
  phoneNumber  String?      @map("phone_number")
  openHour     DateTime?    @map("open_hour") @db.Time(0)
  closeHour    DateTime?    @map("close_hour") @db.Time(0)
  weekDaysOpen Json?        @map("week_days_open")
  addressId    String       @map("address_id")
  address      Address      @relation("StoreAddress", fields: [addressId], references: [id], onDelete: Restrict)
  ownerId      String       @map("owner_id")
  owner        User         @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  cnpj         String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  businessHours             StoreBusinessHour[]
  badges                    Badge[]
  carousels                 Carousel[]
  categories                Category[]                  @relation("StoreCategories")
  menus                     Menu[]                      @relation("StoreMenus")
  orders                    Order[]
  products                  Product[]                   @relation("StoreProducts")
  printers                  PrinterConfiguration[]
  promotions                Promotion[]                 @relation("StorePromotions")
  shippingRules             StoreShipping[]
  neighborhoodShippingRules StoreNeighborhoodShipping[]
  deliveryPartitions DeliveryPartition[]
  subcategories             Subcategory[]               @relation("StoreSubcategories")
  users                     User[]                      @relation("UserStores")
  paymentMethods            StorePaymentMethod[]

  @@index([addressId])
  @@index([isActive])
  @@index([ownerId])
  @@map("stores")
}

model Carousel {
  id               String   @id @default(cuid())
  name             String
  isActive         Boolean  @default(false) @map("is_active")
  content          Json
  storeId          String   @map("store_id") @db.Uuid
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdById      String   @map("created_by_id")
  createdBy        User     @relation("CarouselCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastModifiedById String   @map("last_modified_by_id")
  lastModifiedBy   User     @relation("CarouselUpdater", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([storeId, updatedAt])
  @@index([createdById])
  @@index([lastModifiedById])
  @@map("carousels")
}

model Badge {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  color     String
  icon      String?
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ProductBadge[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@map("badges")
}

model StoreShipping {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  value        Decimal  @db.Decimal(10, 2)
  shippingTime Int      @map("shipping_time")
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  neighborhoodRules StoreNeighborhoodShipping[]

  @@unique([storeId, name])
  @@index([isActive])
  @@index([storeId])
  @@map("store-shipping")
}

model StoreNeighborhoodShipping {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  areaId       String? @unique @map("area_id") @db.Uuid
  area         DeliveryArea? @relation(fields: [areaId, storeId], references: [id, storeId], onDelete: Restrict)
  neighborhood String
  isBlocked    Boolean            @default(false) @map("is_blocked")
  mode         ShippingChargeMode
  shippingId   String?            @map("shipping_id") @db.Uuid
  shipping     StoreShipping?     @relation(fields: [shippingId], references: [id], onDelete: SetNull)
  value        Decimal?           @db.Decimal(10, 2)
  shippingTime Int?               @map("shipping_time")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([areaId, storeId])
  // Legacy uniqueness is a partial SQL index (area_id IS NULL).
  @@index([shippingId])
  @@index([storeId])
  @@map("store_neighborhood_shipping")
}

enum ShippingChargeMode {
  DEFAULT
  MANUAL
  TEMPLATE
}

// ============================================
// MODELO STORE_BUSINESS_HOUR (Horarios por loja)
// ============================================

model StoreBusinessHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  weekDay   Int?      @map("week_day") @db.SmallInt
  date      DateTime? @db.Date
  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([date])
  @@index([isClosed])
  @@index([storeId])
  @@index([weekDay])
  @@map("store_business_hours")
}

// ============================================
// MODELO PAYMENT_METHOD (Métodos de Pagamento)
// ============================================

model PaymentMethod {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        PaymentType
  cardType    PaymentCardType?
  provider    String // AbacatePay, Stripe, etc.
  providerId  String // ID do método no provider
  last4       String? // Últimos 4 dígitos do cartão
  expiryMonth Int?
  expiryYear  Int?
  cardHolder  String?
  isDefault   Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments Payment[]
  orders   Order[]

  @@index([userId])
}

model StorePaymentMethod {
  fields    Json        @default("[]")
  id        String      @id @default(cuid())
  storeId   String      @map("store_id") @db.Uuid
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  type      PaymentType
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  orders                         Order[]
  whatsappMessageConfigurations WhatsAppMessageConfiguration[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@map("store_payment_methods")
}

enum PaymentType {
  CUSTOM
  CREDIT_CARD
  DEBIT_CARD
  PIX
  CASH
}

enum PaymentCardType {
  CREDIT
  DEBIT
}

// ============================================
// MODELO CATEGORY (Categorias de Produtos)
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  additionalFields Json       @default("[]") @map("additional_fields")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menus         Menu[]        @relation("MenuCategories")
  products      Product[]
  printerCategories PrinterCategory[]
  stores        Store[]       @relation("StoreCategories")
  subcategories Subcategory[]

  @@index([isActive])
}

// ============================================
// MODELO MENU (Agrupadores do Cardapio)
// ============================================

model Menu {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories    Category[]    @relation("MenuCategories")
  stores        Store[]       @relation("StoreMenus")
  subcategories Subcategory[] @relation("MenuSubcategories")

  @@index([isActive])
}

// ============================================
// MODELO SUBCATEGORY (Subcategorias de Produtos)
// ============================================

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  additionalFields Json       @default("[]") @map("additional_fields")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menus    Menu[]    @relation("MenuSubcategories")
  products Product[]
  printerSubcategories PrinterSubcategory[]
  stores   Store[]   @relation("StoreSubcategories")

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
}

// ============================================
// CONFIGURACAO DE IMPRESSORAS
// ============================================

model PrinterConfiguration {
  transport String @default("WEB_SERIAL")
  windowsQueueId String? @map("windows_queue_id")
  windowsQueueName String? @map("windows_queue_name")
  windowsDriverName String? @map("windows_driver_name")
  windowsPortName String? @map("windows_port_name")
  windowsPrintProcessor String? @map("windows_print_processor")
  windowsDataType String? @map("windows_data_type")
  windowsCapabilities Json? @map("windows_capabilities")
  adapterId String @default("esc-pos") @map("adapter_id")
  columns Int @default(48)
  encoding String @default("cp850")
  autoCut Boolean @default(true) @map("auto_cut")
  copies Int @default(1)
  lastSeenAt DateTime? @map("last_seen_at")
  lastKnownStatus String? @map("last_known_status")
  bridgeInstallationId String? @map("bridge_installation_id")
  @@unique([storeId, windowsQueueId])
  id               String                  @id @default(cuid())
  storeId          String                  @map("store_id") @db.Uuid
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connectionId     String                  @map("connection_id")
  name             String
  connectionStatus PrinterConnectionStatus @default(DISCONNECTED) @map("connection_status")
  isPrimary        Boolean                 @default(false) @map("is_primary")
  receiptSections  String[]                @default(["customer", "address", "payment", "notes", "totals"]) @map("receipt_sections")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  categories    PrinterCategory[]
  subcategories PrinterSubcategory[]

  @@unique([storeId, connectionId])
  @@unique([storeId, name])
  @@index([storeId, isPrimary])
  @@map("printer_configurations")
}

model PrinterCategory {
  printerId String               @map("printer_id")
  printer   PrinterConfiguration @relation(fields: [printerId], references: [id], onDelete: Cascade)
  categoryId String              @map("category_id")
  category   Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now()) @map("created_at")

  @@id([printerId, categoryId])
  @@index([categoryId])
  @@map("printer_categories")
}

model PrinterSubcategory {
  printerId    String               @map("printer_id")
  printer      PrinterConfiguration @relation(fields: [printerId], references: [id], onDelete: Cascade)
  subcategoryId String              @map("subcategory_id")
  subcategory   Subcategory         @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now()) @map("created_at")

  @@id([printerId, subcategoryId])
  @@index([subcategoryId])
  @@map("printer_subcategories")
}

enum PrinterConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// ============================================
// MODELO PRODUCT (Produtos)
// ============================================

model Product {
  id               String       @id @default(cuid())
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId    String?
  subcategory      Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  name             String
  description      String
  price            Decimal      @db.Decimal(10, 2)
  imageUrl         String?
  additionalFields Json         @default("[]") @map("additional_fields")
  unavailable      Boolean      @default(false)
  isActive         Boolean      @default(true)
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orderItems OrderItem[]
  badges     ProductBadge[]
  promotions PromotionProduct[]
  reviews    Review[]
  favorites  Favorite[]
  stores     Store[]            @relation("StoreProducts")

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
}

model ProductBadge {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  badgeId   String   @map("badge_id")
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, badgeId])
  @@index([badgeId])
  @@index([productId])
  @@map("product_badges")
}

// ============================================
// MODELO ORDER (Pedidos)
// ============================================

model Order {
  confirmedAt DateTime? @map("confirmed_at")
  deliveryMinutes Int? @map("delivery_minutes")
  paymentAdditionalValue Decimal @default(0) @map("payment_additional_value") @db.Decimal(10, 2)
  paymentFieldValues Json @default("[]") @map("payment_field_values")
  paymentType       PaymentType?
  id                String         @id @default(cuid())
  orderNumber       Int            @unique @default(autoincrement())
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  addressId         String?
  address           Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  storeId           String?        @map("store_id") @db.Uuid
  store             Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  storePaymentMethodId String? @map("store_payment_method_id")
  storePaymentMethod StorePaymentMethod? @relation(fields: [storePaymentMethodId], references: [id], onDelete: Restrict)
  promotionId       String?        @map("promotion_id")
  promotion         Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  status            OrderStatus    @default(PENDING)
  subtotal          Decimal        @db.Decimal(10, 2)
  deliveryFee       Decimal        @db.Decimal(10, 2)
  discount          Decimal        @default(0) @db.Decimal(10, 2)
  total             Decimal        @db.Decimal(10, 2)
  notes             String?
  deliveryAreaId String? @map("delivery_area_id") @db.Uuid
  deliveryArea DeliveryArea? @relation(fields: [deliveryAreaId], references: [id], onDelete: Restrict)
  deliveryAreaSnapshot Json? @map("delivery_area_snapshot")
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items           OrderItem[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@index([promotionId])
}

enum OrderStatus {
  PENDING // Pedido feito, aguardando aprovação
  CONFIRMED // Pedido confirmado
  PREPARING // Em preparação
  ON_THE_WAY // A caminho
  DELIVERED // Entregue
  CANCELLED // Cancelado
}

model WhatsAppMessageConfiguration {
  id        String                   @id @default(cuid())
  location  WhatsAppMessageLocation
  operation WhatsAppMessageOperation
  template  Json
  isActive  Boolean                  @default(true) @map("is_active")
  paymentMethodId String?            @map("payment_method_id")
  paymentMethod StorePaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@index([location, operation, isActive])
  @@map("whatsapp_message_configurations")
}

enum WhatsAppMessageLocation {
  PIX_ONLINE
  PENDING
  CONFIRMED
  PREPARING
  ON_THE_WAY
}

enum WhatsAppMessageOperation {
  ENTRY
  EXIT
}

// ============================================
// MODELO FISCAL_DOCUMENT (Documentos fiscais)
// ============================================

model FiscalDocument {
  id            String               @id @default(cuid())
  orderId       String               @map("order_id")
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          FiscalDocumentType
  status        FiscalDocumentStatus @default(PENDING)
  model         String?              @db.VarChar(2)
  serie         String?              @db.VarChar(3)
  emissionType  String?              @map("emission_type") @db.VarChar(1)
  fiscalNumber  String?              @map("fiscal_number") @db.VarChar(9)
  accessKey     String?              @unique @map("access_key")
  protocol      String?
  qrCodeUrl     String?              @map("qr_code_url")
  xmlContent    String?              @map("xml_content")
  xmlPath       String?              @map("xml_path")
  pdfPath       String?              @map("pdf_path")
  sefazResponse Json?                @map("sefaz_response")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("fiscal_documents")
}

enum FiscalDocumentType {
  NFE
  NFCE
}

enum FiscalDocumentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELED
  CONTINGENCY
}

// ============================================
// MODELO FISCAL_SEQUENCE (Sequencias fiscais)
// ============================================

model FiscalSequence {
  id            String   @id @default(cuid())
  model         String   @db.VarChar(2)
  serie         String   @default("009") @db.VarChar(3)
  currentNumber Int      @default(0) @map("current_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([model, serie])
  @@map("fiscal_sequences")
}

// ============================================
// MODELO ORDER_ITEM (Itens do Pedido)
// ============================================

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  notes     String?

  @@index([orderId])
  @@index([productId])
}

// ============================================
// MODELO PAYMENT (Pagamentos)
// ============================================

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId  String
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  provider         String // AbacatePay
  providerTxId     String? // ID da transação no provider
  providerResponse Json? // Resposta completa do provider
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================
// MODELO PROMOTION (Promoções)
// ============================================

model Promotion {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  type              PromotionType
  value             Decimal                  @db.Decimal(10, 2)
  minPurchase       Decimal?                 @db.Decimal(10, 2)
  maxDiscount       Decimal?                 @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime
  eligibilityType   PromotionEligibilityType @default(ALL) @map("eligibility_type")
  eligibilityTarget Json?                    @map("eligibility_target")
  usageMode         PromotionUsageMode       @default(AVAILABLE_PERIOD) @map("usage_mode")
  usageLimit        Int?                     @map("usage_limit")
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  products PromotionProduct[]
  stores   Store[]            @relation("StorePromotions")
  orders   Order[]

  @@index([eligibilityType])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([usageMode])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
}

enum PromotionEligibilityType {
  ALL
  GROUP
  SINGLE_USER
}

enum PromotionUsageMode {
  USAGE_QUANTITY
  AVAILABLE_PERIOD
}

model UserGroup {
  id        String        @id @default(cuid())
  name      String        @unique
  mode      UserGroupMode @default(MANUAL)
  rules     Json          @default("[]")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  members UserGroupMember[]

  @@map("user_groups")
}

enum UserGroupMode {
  MANUAL
  RULE
}

model UserGroupMember {
  id        String    @id @default(cuid())
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("user_group_members")
}

model PromotionProduct {
  id          String               @id @default(cuid())
  promotionId String
  promotion   Promotion            @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  role        PromotionProductRole @default(TARGET)

  @@unique([promotionId, productId, role])
}

enum PromotionProductRole {
  TARGET
  REWARD
}

// ============================================
// MODELO SYSTEM_SETTINGS (Configurações do Sistema)
// ============================================

model SystemSettings {
  id                String   @id @default(cuid())
  storeName         String   @default("Delivery Cruzeiro")
  storeOpen         Boolean  @default(true)
  autoApproveOrders Boolean  @default(false)
  minOrderValue     Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryMin   Decimal? @db.Decimal(10, 2)
  pointsEnabled     Boolean  @default(false)
  pointsPerReal     Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// MODELO DELIVERY_ZONE (Zonas de Entrega)
// ============================================

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String
  neighborhood String
  city         String
  state        String
  zipCode      String?
  fee          Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

// ============================================
// MODELO NOTIFICATION (Notificações)
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_ON_THE_WAY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PROMOTION
  SYSTEM
}

// ============================================
// MODELO POINT (Pontos de Fidelidade)
// ============================================

model Point {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  amount      Int // Pontos ganhos ou gastos
  type        PointType
  description String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum PointType {
  EARNED
  REDEEMED
}

// ============================================
// MODELO REVIEW (Avaliações)
// ============================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

// ============================================
// MODELO FAVORITE (Favoritos)
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// MODELO CUP_POLL_GUESS (Palpite Certo)
// ============================================

model CupPollGuess {
  id              String   @id @default(cuid())
  instagramHandle String   @map("instagram_handle")
  score           String
  scoreFormat     String   @default("br-no") @map("score_format")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([instagramHandle, scoreFormat])
  @@index([createdAt])
  @@map("cup_poll_guesses")
}

// ============================================
// MODELO POOL_WINNER (Resultados dos Bolões)
// ============================================

model PoolWinner {
  match        String   @id @map("match")
  result       String
  firstWinner  String?  @map("first_winner")
  secondWinner String?  @map("second_winner")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("pool_winners")
}



model NeighborhoodReference {
  id String @id @db.Uuid
  state String
  cityCode String @map("city_code")
  city String
  sourceCode String @map("source_code")
  name String
  geometry Json
  sourceHash String @map("source_hash")
  partitions DeliveryPartition[]
  @@unique([state, cityCode, sourceCode])
  @@map("neighborhood_references")
}
model DeliveryPartition {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  neighborhoodId String @map("neighborhood_id") @db.Uuid
  neighborhood NeighborhoodReference @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)
  activeRevision Int @default(1) @map("active_revision")
  revisions DeliveryPartitionRevision[]
  @@unique([storeId, neighborhoodId])
  @@unique([id, storeId])
  @@map("delivery_partitions")
}
model DeliveryPartitionRevision {
  id String @id @default(uuid()) @db.Uuid
  partitionId String @map("partition_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid
  partition DeliveryPartition @relation(fields: [partitionId, storeId], references: [id, storeId], onDelete: Restrict)
  revision Int
  sourceHash String @map("source_hash")
  cuts Json
  requestId String @map("request_id") @db.Uuid
  requestHash String @map("request_hash")
  authorId String @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  areas DeliveryArea[]
  @@unique([partitionId, revision])
  @@unique([storeId, requestId])
  @@unique([id, storeId])
  @@map("delivery_partition_revisions")
}
model DeliveryArea {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid
  revision DeliveryPartitionRevision @relation(fields: [revisionId, storeId], references: [id, storeId], onDelete: Restrict)
  index Int
  name String
  geometry Json
  inheritedFrom Json @map("inherited_from")
  rule StoreNeighborhoodShipping?
  orders Order[]
  @@unique([revisionId, index])
  @@unique([id, storeId])
  @@map("delivery_areas")
}


