# Database
POSTGRES_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@delivery.local
DEFAULT_ADMIN_PASSWORD=
DATABASE_URL=postgresql://delivery_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/delivery_cruzeiro?schema=public

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177"

# JWT
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4000"

# AbacatePay
ABACATEPAY_API_KEY=
ABACATEPAY_API_URL="https://api.abacatepay.com.br"

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER="delivery-cruzeiro"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS=
SMTP_FROM="noreply@deliverycruzeiro.com"

# WhatsApp
WAHA_URL="http://waha:3000"
WAHA_API_KEY=
WAHA_SESSION="default"
WAHA_TIMEOUT_MS=10000

# Fiscal / SEFAZ
CERTIFICATE_PATH=""
# Configure the certificate password only in the private deployment environment.
SEFAZ_ENVIRONMENT=2
SEFAZ_AUTHORIZATION_URL="https://nfe.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_AUTHORIZATION_URL_HOMOLOG="https://nfe-homologacao.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_NFE_AUTHORIZATION_URL="https://nfe.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_NFE_AUTHORIZATION_URL_HOMOLOG="https://nfe-homologacao.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_NFCE_AUTHORIZATION_URL="https://nfce.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_NFCE_AUTHORIZATION_URL_HOMOLOG="https://nfce-homologacao.svrs.rs.gov.br/ws/NfeAutorizacao/NFeAutorizacao4.asmx"
SEFAZ_NFE_RET_AUTHORIZATION_URL="https://nfe.svrs.rs.gov.br/ws/NfeRetAutorizacao/NFeRetAutorizacao4.asmx"
SEFAZ_NFE_RET_AUTHORIZATION_URL_HOMOLOG="https://nfe-homologacao.svrs.rs.gov.br/ws/NfeRetAutorizacao/NFeRetAutorizacao4.asmx"
SEFAZ_NFCE_RET_AUTHORIZATION_URL="https://nfce.svrs.rs.gov.br/ws/NfeRetAutorizacao/NFeRetAutorizacao4.asmx"
SEFAZ_NFCE_RET_AUTHORIZATION_URL_HOMOLOG="https://nfce-homologacao.svrs.rs.gov.br/ws/NfeRetAutorizacao/NFeRetAutorizacao4.asmx"
CSC_ID="000002"
CSC_PRODUCTION=
CSC_HOMOLOGATION=
NFCE_QRCODE_URL_PRODUCTION="http://www.sefaz.pb.gov.br/nfce/qrcode"
NFCE_QRCODE_URL_HOMOLOGATION="http://www.sefaz.pb.gov.br/nfcehom/qrcode"

# Generate unique values using the Infra Docker setup. Never reuse sample keys.
APP_DB_PASSWORD=
DATA_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8080
ALLOW_INSECURE_LOCALHOST=true
